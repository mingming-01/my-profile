# Local development only. Never commit a real .env file.
APP_ENV=development
FLASK_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5000
DATABASE_PATH=instance/passkeys.sqlite3
# Set DATABASE_URL only when using PostgreSQL (for example, Supabase).
# DATABASE_URL=postgresql://...
PASSKEY_INVITE_TOKENS='{"account-a":"replace-with-a-random-token-of-at-least-32-characters","account-b":"replace-with-another-random-token-of-at-least-32-characters"}'
